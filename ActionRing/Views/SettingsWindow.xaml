<Window x:Class="ActionRing.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ActionRing.Views"
        Title="Action Ring"
        Width="980" Height="680" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        ThemeMode="Dark"
        Background="Transparent" Foreground="#F5F5F5"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#00292929" />
        <SolidColorBrush x:Key="CardBrush" Color="#D13B363C" />
        <SolidColorBrush x:Key="NavSelectedBrush" Color="#66483F4B" />
        <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#C92B242D" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#28FFFFFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9A9A9" />
        <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- Do not declare implicit styles for framework controls here. Doing so
             masks the .NET Fluent theme and brings the old light templates back. -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Height" Value="36" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8BDDFF" />
                    <Setter Property="BorderBrush" Value="#8BDDFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="4,10" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ActionTreeItemStyle" TargetType="TreeViewItem"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="True" />
        </Style>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SettingName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="SwitchTrack" Grid.Column="1" Width="40" Height="20" Margin="20,0,0,0"
                                    CornerRadius="10" BorderThickness="1" BorderBrush="#9A9A9A" Background="#463F46">
                                <Ellipse x:Name="SwitchKnob" Width="12" Height="12" Margin="3"
                                         HorizontalAlignment="Left" Fill="#E8E8E8" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#D0D0D0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="#111111" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:ActionItemViewModel}" ItemsSource="{Binding Children}">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="6" Background="#3D3D3D">
                    <TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Kind}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Border Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Action Ring" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Background="Transparent" BorderThickness="0" Padding="0" Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="Transparent" BorderThickness="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="8,18,8,0">
                            <TextBlock Text="SETTINGS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="14,0,0,8" />
                            <Button x:Name="GeneralNav" Style="{StaticResource NavButton}" Click="GeneralNav_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="GeneralIndicator" Width="3" Height="18" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="General" Margin="8,0,0,0" />
                                </Grid>
                            </Button>
                            <Button x:Name="ActionsNav" Style="{StaticResource NavButton}" Click="ActionsNav_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="ActionsIndicator" Width="3" Height="18" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Visibility="Collapsed" />
                                    <TextBlock Grid.Column="1" Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Actions" Margin="8,0,0,0" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource ContentSurfaceBrush}"
                        CornerRadius="10,0,0,0" />

                <!-- GENERAL -->
                <ScrollViewer x:Name="GeneralPage" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="42,30,42,36">
                        <TextBlock Text="General" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Choose how the ring opens, behaves, and looks."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,30" />

                        <TextBlock Text="Activation &amp; behavior" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Keyboard shortcut" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="The global shortcut that opens Action Ring." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox x:Name="HotKeyBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <CheckBox x:Name="HoldToActivateCheck" Style="{StaticResource ToggleSwitch}">
                                <StackPanel>
                                    <TextBlock Text="Hold and flick" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Hold the shortcut, point at an action, then release to run it." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hold threshold" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Delay before a press becomes a hold gesture, in milliseconds." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox x:Name="HoldThresholdBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <CheckBox x:Name="FollowCursorCheck" Style="{StaticResource ToggleSwitch}">
                                <StackPanel>
                                    <TextBlock Text="Follow the pointer" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Open the ring at the mouse pointer instead of the screen centre." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,26,0,10" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Action size" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Radius of each action button." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox x:Name="ButtonRadiusBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ring radius" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Distance between the centre and actions." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox x:Name="OrbitRadiusBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Centre size" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Radius of the close button." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox x:Name="HubRadiusBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Tint colour" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Hex colour for the acrylic ring surface." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox x:Name="TintBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Accent colour" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Default highlight colour used by ring actions." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox x:Name="AccentBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Tint opacity" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Lower values make the ring more transparent." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="TintOpacitySlider" Minimum="0.1" Maximum="1"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=TintOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <CheckBox x:Name="ShowLabelsCheck" Style="{StaticResource ToggleSwitch}">
                                <StackPanel>
                                    <TextBlock Text="Action labels" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Show an action's name when it is hovered." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <CheckBox x:Name="HardwareAccelerationCheck" Style="{StaticResource ToggleSwitch}">
                                <StackPanel>
                                    <TextBlock Text="Hardware acceleration" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Use the GPU to render the ring. Takes effect after restarting Action Ring." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- ACTIONS -->
                <Grid x:Name="ActionsPage" Grid.Column="1" Visibility="Collapsed" Margin="42,30,42,36">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Actions" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Create, order, and group the commands shown around the ring." Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,10,4,10">
                            <DockPanel>
                                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Content="+ Add" Click="AddAction_Click" HorizontalAlignment="Left" />
                                    <Button Grid.Column="1" Content="&#xE74A;" ToolTip="Move up" Style="{StaticResource IconButton}" Click="MoveUp_Click" Margin="4,0,0,0" />
                                    <Button Grid.Column="2" Content="&#xE74B;" ToolTip="Move down" Style="{StaticResource IconButton}" Click="MoveDown_Click" Margin="4,0,0,0" />
                                    <Button Grid.Column="3" Content="&#xE74D;" ToolTip="Delete" Style="{StaticResource IconButton}" Click="DeleteAction_Click" Margin="4,0,0,0" />
                                </Grid>
                                <TreeView x:Name="ActionsTree" ItemsSource="{Binding Actions}"
                                          Background="Transparent" BorderThickness="0"
                                          ItemContainerStyle="{StaticResource ActionTreeItemStyle}"
                                          SelectedItemChanged="ActionsTree_SelectedItemChanged" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="22,22,6,22">
                            <Grid>
                                <TextBlock x:Name="EmptyActionMessage" Text="Select an action to edit it." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ScrollViewer x:Name="ActionEditor" Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Action details" Style="{StaticResource SectionTitle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Name" FontWeight="SemiBold" />
                                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,14" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Glyph" FontWeight="SemiBold" />
                                                <Grid Margin="0,7,0,14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Glyph, UpdateSourceTrigger=PropertyChanged}"
                                                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" />
                                                    <ComboBox Grid.Column="1" Margin="5,0,0,0" ToolTip="Choose a Segoe Fluent icon"
                                                              ItemsSource="{Binding AvailableGlyphs}"
                                                              SelectedItem="{Binding Glyph, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              MaxDropDownHeight="320" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                              FontSize="17" HorizontalContentAlignment="Center">
                                                        <ComboBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel IsItemsHost="True" Orientation="Horizontal" Width="220" />
                                                            </ItemsPanelTemplate>
                                                        </ComboBox.ItemsPanel>
                                                        <ComboBox.ItemContainerStyle>
                                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                                <Setter Property="Width" Value="44" />
                                                                <Setter Property="Height" Value="40" />
                                                                <Setter Property="Padding" Value="0" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                            </Style>
                                                        </ComboBox.ItemContainerStyle>
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                           FontSize="18" HorizontalAlignment="Center" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Type" FontWeight="SemiBold" />
                                        <ComboBox x:Name="KindBox" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,14" SelectionChanged="KindBox_SelectionChanged" />
                                        <TextBlock x:Name="TargetLabel" Text="Target" FontWeight="SemiBold" />
                                        <TextBox x:Name="TargetEditor" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" />
                                        <TextBlock x:Name="TargetHint" Style="{StaticResource Caption}" Margin="0,4,0,14" />
                                        <StackPanel x:Name="ArgumentsPanel">
                                            <TextBlock Text="Arguments" FontWeight="SemiBold" />
                                            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,14" />
                                        </StackPanel>
                                        <TextBlock Text="Custom accent" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Accent, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" />
                                        <TextBlock Text="Optional hex colour. Leave blank to use the global accent." Style="{StaticResource Caption}" />

                                        <Border Background="#25334B" BorderBrush="#38527A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,20,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Sub-actions" FontWeight="SemiBold" />
                                                    <TextBlock Text="Add a child to make this action expand on hover." Style="{StaticResource Caption}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="+ Add child" Click="AddChild_Click" Margin="12,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           Margin="22,0,12,0" VerticalAlignment="Center">
                    Created with <Run Text="&#x2665;" Foreground="#FF6B81" /> by
                    <Hyperlink NavigateUri="https://dan13.me/?utm_source=ActionRing"
                               RequestNavigate="AuthorLink_RequestNavigate">DanRotaru</Hyperlink>
                </TextBlock>
                <Border Grid.Column="1" Background="{StaticResource ContentSurfaceBrush}"
                        BorderThickness="0">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Foreground="#E87A7A" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"
                                MinWidth="86" Height="36" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}"
                                MinWidth="86" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
