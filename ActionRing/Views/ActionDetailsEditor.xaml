<UserControl x:Class="ActionRing.Views.ActionDetailsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F5F5F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="EditorMutedBrush" Color="#A9A9A9" />
        <SolidColorBrush x:Key="EditorStrokeBrush" Color="#1AFFFFFF" />
    </UserControl.Resources>
    <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="4,2,10,8">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Action details" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Width="28" Height="28" Padding="0" ToolTip="Restore this action" Click="Revert_Click"
                        Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <TextBlock Text="Name" FontWeight="SemiBold" />
            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,14" />

            <TextBlock Text="Icon source" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,7,0,12">
                <RadioButton Content="Glyph" GroupName="RingEditorIconSource"
                             IsChecked="{Binding UseGlyph, Mode=TwoWay}" Margin="0,0,20,0" />
                <RadioButton Content="App icon" GroupName="RingEditorIconSource"
                             IsChecked="{Binding UseAppIcon, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Visibility="{Binding UseGlyph, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14">
                <TextBlock Text="Glyph" FontWeight="SemiBold" />
                <Border Margin="0,7,0,0" Padding="7" CornerRadius="7"
                        Background="#08000000" BorderBrush="{StaticResource EditorStrokeBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="2,0,2,7">
                            <TextBox x:Name="GlyphSearch" Height="34" Padding="34,5,10,5"
                                     VerticalContentAlignment="Center" TextChanged="GlyphSearch_TextChanged"
                                     ToolTip="Search icons by name, keyword, or Unicode codepoint" />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource EditorMutedBrush}" Margin="11,0,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock x:Name="GlyphSearchPlaceholder" Text="Search glyphs"
                                       Foreground="{StaticResource EditorMutedBrush}" Margin="34,0,10,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <ListBox x:Name="GlyphList" Height="168" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="38" Margin="2">
                                                    <Button Padding="0" ToolTip="{Binding Name}" Click="Glyph_Click"
                                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="18" Foreground="#F5F5F5"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Border CornerRadius="4" BorderBrush="#60CDFF" BorderThickness="2"
                                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"
                                                            IsHitTestVisible="False" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding UseAppIcon, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="App icon path" FontWeight="SemiBold" />
                <Grid Margin="0,7,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" MinWidth="96" Margin="8,0,0,0" Padding="12,0"
                            VerticalAlignment="Stretch" Click="BrowseIcon_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="Browse…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Text="An .ico, .png, image, or executable path." Foreground="{StaticResource EditorMutedBrush}"
                           FontSize="11" Margin="0,0,0,14" />
            </StackPanel>

            <TextBlock Text="Type" FontWeight="SemiBold" />
            <ComboBox x:Name="KindBox" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,7,0,14" SelectionChanged="KindBox_SelectionChanged" />
            <TextBlock x:Name="TargetLabel" Text="Target" FontWeight="SemiBold" />
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TargetBox" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
                <Button x:Name="BrowseTargetButton" Grid.Column="1" MinWidth="96" Margin="8,0,0,0"
                        Padding="12,0" VerticalAlignment="Stretch" Click="BrowseTarget_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Browse…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock x:Name="TargetHint" Foreground="{StaticResource EditorMutedBrush}" FontSize="11" Margin="0,4,0,14" TextWrapping="Wrap" />

            <StackPanel x:Name="ArgumentsPanel">
                <TextBlock Text="Arguments" FontWeight="SemiBold" />
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,14" />
            </StackPanel>

            <TextBlock Text="Custom accent" FontWeight="SemiBold" />
            <TextBox Text="{Binding Accent, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" />
            <TextBlock Text="Optional hex colour. Leave blank to use the global accent."
                       Foreground="{StaticResource EditorMutedBrush}" FontSize="11" Margin="0,4,0,14" TextWrapping="Wrap" />

            <Border Background="#0DFFFFFF" BorderBrush="{StaticResource EditorStrokeBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Sub-actions" FontWeight="SemiBold" />
                        <TextBlock Text="Add a child to make this action expand on hover."
                                   Foreground="{StaticResource EditorMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Margin="8,0,0,0" Click="AddChild_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" />
                            <TextBlock Text="Add child" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
