<Window x:Class="ActionRing.Views.RingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Action Ring"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Window.Resources>

    <!-- Everything is generated in code-behind: the segment count is driven by
         the config, so there is nothing static to declare here. -->
    <Grid x:Name="Root">
        <Canvas x:Name="Surface" />
    </Grid>
</Window>
