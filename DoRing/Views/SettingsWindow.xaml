<Window x:Class="DoRing.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DoRing.Views"
        xmlns:services="clr-namespace:DoRing.Services"
        Title="DoRing"
        Width="980" Height="680" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        ThemeMode="Dark"
        Background="Transparent" Foreground="#F5F5F5"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#00292929" />
        <SolidColorBrush x:Key="CardBrush" Color="#10FFFFFF" />
        <SolidColorBrush x:Key="NavSelectedBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9A9A9" />
        <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- Keep framework controls on the native .NET Fluent theme. Local
             presentation adjustments are applied directly to each control. -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimarySurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Background" Value="#8BDDFF" />
                                <Setter TargetName="PrimarySurface" Property="BorderBrush" Value="#8BDDFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Background" Value="#4FC3F7" />
                                <Setter TargetName="PrimarySurface" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="4,9" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface" Background="{TemplateBinding Background}"
                                CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="FooterLinkButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FooterLinkSurface" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterLinkSurface" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FooterLinkSurface" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResetButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE777;" />
            <Setter Property="ToolTip" Value="Restore default" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="7,-2,0,-2" />
            <Setter Property="Visibility" Value="Hidden" />
        </Style>
        <Style x:Key="ActionTreeItemStyle" TargetType="TreeViewItem"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="True" />
        </Style>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SettingName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="SwitchTrack" Grid.Column="1" Width="44" Height="22" Margin="20,0,0,0"
                                    CornerRadius="11" BorderThickness="1" BorderBrush="#9A9A9A" Background="#463F46">
                                <Ellipse x:Name="SwitchKnob" Width="14" Height="14" Fill="#E8E8E8"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                            <TranslateTransform X="0" />
                                        </TransformGroup>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#D0D0D0" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             To="1.12" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             To="1.12" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwitchKnob" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="#111111" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             To="22" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:ActionItemViewModel}" ItemsSource="{Binding Children}">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="6" Background="#3D3D3D">
                    <Grid>
                        <Image Source="{Binding DisplayIcon}" Width="20" Height="20" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding UseAppImage, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding DisplayGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{Binding GlyphFont}" Foreground="{Binding GlyphBrush}" FontSize="15"
                                   Visibility="{Binding UseDisplayGlyph, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Kind}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Border Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="DoRing" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Background="Transparent" BorderThickness="0" Padding="0" Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="Transparent" BorderThickness="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="4,10,4,0">
                            <TextBlock Text="SETTINGS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,8" />
                            <Button x:Name="GeneralNav" Style="{StaticResource NavButton}" Click="GeneralNav_Click">
                                <Grid>
                                    <Border x:Name="GeneralIndicator" Width="3" Height="18" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="-4,0,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16" Width="26" TextAlignment="Center" />
                                        <TextBlock Text="General" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="ActionsRingNav" Style="{StaticResource NavButton}" Click="ActionsRingNav_Click">
                                <Grid>
                                    <Border x:Name="ActionsRingIndicator" Width="3" Height="18" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                            Margin="-4,0,0,0" Visibility="Collapsed" />
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                        <TextBlock Text="&#xE81E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16" Width="26" TextAlignment="Center" />
                                        <TextBlock Text="Actions" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource ContentSurfaceBrush}"
                        CornerRadius="10,0,0,0" />

                <!-- GENERAL -->
                <ScrollViewer x:Name="GeneralPage" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                              Focusable="False" FocusVisualStyle="{x:Null}" BorderThickness="0">
                    <StackPanel Margin="32,26,32,36">
                        <TextBlock Text="General" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Choose how the ring opens, behaves, and looks."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,30" />

                        <TextBlock Text="Activation &amp; behavior" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Keyboard shortcut" Style="{StaticResource SettingName}" /><Button x:Name="ResetHotKey" Tag="HotKey" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel>
                                    <TextBlock Text="The global shortcut that opens DoRing." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox x:Name="HotKeyBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="HoldToActivateCheck" Style="{StaticResource ToggleSwitch}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Hold and flick" Style="{StaticResource SettingName}" /><Button x:Name="ResetHoldToActivate" Tag="HoldToActivate" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel>
                                        <TextBlock Text="Hold the shortcut, point at an action, then release to run it." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </CheckBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Hold threshold" Style="{StaticResource SettingName}" /><Button x:Name="ResetHoldThreshold" Tag="HoldThresholdMs" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel>
                                    <TextBlock Text="Delay before a press becomes a hold gesture, in milliseconds." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox x:Name="HoldThresholdBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="FollowCursorCheck" Style="{StaticResource ToggleSwitch}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Follow the pointer" Style="{StaticResource SettingName}" /><Button x:Name="ResetFollowCursor" Tag="FollowCursor" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel>
                                        <TextBlock Text="Open the ring at the mouse pointer instead of the screen centre." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </CheckBox>
                            </Grid>
                        </Border>

                        <TextBlock Text="Motion" Style="{StaticResource SectionTitle}" Margin="0,26,0,10" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Animation" Style="{StaticResource SettingName}" /><Button x:Name="ResetAnimation" Tag="Animation" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel>
                                    <TextBlock x:Name="AnimationCaption" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <ComboBox x:Name="AnimationBox" Grid.Column="1" VerticalAlignment="Center"
                                          ItemsSource="{Binding Animations}" DisplayMemberPath="Name"
                                          SelectionChanged="AnimationBox_SelectionChanged" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Animation speed" Style="{StaticResource SettingName}" /><Button x:Name="ResetAnimationSpeed" Tag="AnimationSpeed" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Higher is quicker. Applies to both directions." Style="{StaticResource Caption}" /></StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="AnimationSpeedSlider" Minimum="0.5" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=AnimationSpeedSlider, Path=Value, StringFormat={}{0:0.0}&#215;}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Animation travel" Style="{StaticResource SettingName}" /><Button x:Name="ResetAnimationTravel" Tag="AnimationTravel" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="How far the ring grows, turns, or slides. Lower is subtler." Style="{StaticResource Caption}" /></StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="AnimationTravelSlider" Minimum="0.25" Maximum="1.75" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=AnimationTravelSlider, Path=Value, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="AnimateCloseCheck" Style="{StaticResource ToggleSwitch}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Animate closing" Style="{StaticResource SettingName}" /><Button x:Name="ResetAnimateClose" Tag="AnimateClose" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Play the same animation in reverse on the way out. Off, the ring vanishes and a chosen action runs at once." Style="{StaticResource Caption}" TextWrapping="Wrap" /></StackPanel>
                                </CheckBox>
                            </Grid>
                        </Border>

                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,26,0,10" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Action size" Style="{StaticResource SettingName}" /><Button x:Name="ResetButtonRadius" Tag="ButtonRadius" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Radius of each action button." Style="{StaticResource Caption}" /></StackPanel>
                                <TextBox x:Name="ButtonRadiusBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Ring radius" Style="{StaticResource SettingName}" /><Button x:Name="ResetOrbitRadius" Tag="OrbitRadius" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Distance between the centre and actions." Style="{StaticResource Caption}" /></StackPanel>
                                <TextBox x:Name="OrbitRadiusBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Close button size" Style="{StaticResource SettingName}" /><Button x:Name="ResetHubRadius" Tag="HubRadius" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Radius of the close button." Style="{StaticResource Caption}" /></StackPanel>
                                <TextBox x:Name="HubRadiusBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Tint color" Style="{StaticResource SettingName}" /><Button x:Name="ResetTint" Tag="Tint" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Hex color for the acrylic ring surface." Style="{StaticResource Caption}" /></StackPanel>
                                <Button Grid.Column="1" Padding="4" Margin="0,0,6,0" ToolTip="Choose tint color" Click="TintColor_Click">
                                    <Border Width="20" Height="20" CornerRadius="3" BorderBrush="#55FFFFFF" BorderThickness="1" Background="{Binding Text, ElementName=TintBox}" />
                                </Button>
                                <TextBox x:Name="TintBox" Grid.Column="2" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Accent color" Style="{StaticResource SettingName}" /><Button x:Name="ResetAccent" Tag="Accent" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Default highlight color used by ring actions." Style="{StaticResource Caption}" /></StackPanel>
                                <Button Grid.Column="1" Padding="4" Margin="0,0,6,0" ToolTip="Choose accent color" Click="AccentColor_Click">
                                    <Border Width="20" Height="20" CornerRadius="3" BorderBrush="#55FFFFFF" BorderThickness="1" Background="{Binding Text, ElementName=AccentBox}" />
                                </Button>
                                <TextBox x:Name="AccentBox" Grid.Column="2" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Tint opacity" Style="{StaticResource SettingName}" /><Button x:Name="ResetTintOpacity" Tag="TintOpacity" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Lower values make the ring more transparent." Style="{StaticResource Caption}" /></StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="TintOpacitySlider" Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=TintOpacitySlider, Path=Value, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="ShowLabelsCheck" Style="{StaticResource ToggleSwitch}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Action labels" Style="{StaticResource SettingName}" /><Button x:Name="ResetShowLabels" Tag="ShowLabels" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Show an action's name when it is hovered." Style="{StaticResource Caption}" /></StackPanel>
                                </CheckBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="ColoredIconsCheck" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding Source={x:Static services:IconPreferences.Instance}, Path=Colored, Mode=TwoWay}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Colored icons" Style="{StaticResource SettingName}" /><Button x:Name="ResetColoredIcons" Tag="ColoredIcons" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Draw Simple Icons in their brand color instead of white." Style="{StaticResource Caption}" /></StackPanel>
                                </CheckBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="ColoredEmojiCheck" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding Source={x:Static services:IconPreferences.Instance}, Path=ColoredEmoji, Mode=TwoWay}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Colored emoji" Style="{StaticResource SettingName}" /><Button x:Name="ResetColoredEmoji" Tag="ColoredEmoji" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Draw emoji in color instead of monochrome outlines." Style="{StaticResource Caption}" /></StackPanel>
                                </CheckBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="FadeOthersOnGroupOpenCheck" Style="{StaticResource ToggleSwitch}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Fade other actions with a group open" Style="{StaticResource SettingName}" /><Button x:Name="ResetFadeOthersOnGroupOpen" Tag="FadeOthersOnGroupOpen" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Show other actions at 80% opacity while a group is open." Style="{StaticResource Caption}" /></StackPanel>
                                </CheckBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="SettingsOnCloseRightClickCheck" Style="{StaticResource ToggleSwitch}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Open app settings by right click to the close button" Style="{StaticResource SettingName}" /><Button x:Name="ResetSettingsOnCloseRightClick" Tag="SettingsOnCloseRightClick" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Right-click the centre close button to open this window." Style="{StaticResource Caption}" /></StackPanel>
                                </CheckBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="CloseAfterSavingCheck" Style="{StaticResource ToggleSwitch}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Close settings after saving" Style="{StaticResource SettingName}" /><Button x:Name="ResetCloseAfterSaving" Tag="CloseAfterSaving" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Close this window once Save succeeds instead of staying open." Style="{StaticResource Caption}" /></StackPanel>
                                </CheckBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="HardwareAccelerationCheck" Style="{StaticResource ToggleSwitch}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Hardware acceleration" Style="{StaticResource SettingName}" /><Button x:Name="ResetHardwareAcceleration" Tag="HardwareAcceleration" Style="{StaticResource ResetButton}" Click="ResetSetting_Click" /></StackPanel><TextBlock Text="Use the GPU to render the ring. Takes effect after restarting DoRing." Style="{StaticResource Caption}" /></StackPanel>
                                </CheckBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- ACTIONS -->
                <Grid x:Name="ActionsPage" Grid.Column="1" Visibility="Collapsed" Margin="42,30,42,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Actions" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Create, order, and group the commands shown around the ring." Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10">
                            <DockPanel>
                                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Click="AddAction_Click" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Add" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Content="&#xE74A;" ToolTip="Move up" Style="{StaticResource IconButton}" Click="MoveUp_Click" Margin="4,0,0,0" />
                                    <Button Grid.Column="2" Content="&#xE74B;" ToolTip="Move down" Style="{StaticResource IconButton}" Click="MoveDown_Click" Margin="4,0,0,0" />
                                    <Button Grid.Column="3" Content="&#xE74D;" ToolTip="Delete" Style="{StaticResource IconButton}" Click="DeleteAction_Click" Margin="4,0,0,0" />
                                </Grid>
                                <TreeView x:Name="ActionsTree" ItemsSource="{Binding Actions}"
                                          Background="Transparent" BorderThickness="0"
                                          Padding="0,0,14,0"
                                          ItemContainerStyle="{StaticResource ActionTreeItemStyle}"
                                          SelectedItemChanged="ActionsTree_SelectedItemChanged" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="22">
                            <Grid>
                                <TextBlock x:Name="EmptyActionMessage" Text="Select an action to edit it." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ScrollViewer x:Name="ActionEditor" Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto" Padding="0,0,18,0"
                                              BorderThickness="0" FocusVisualStyle="{x:Null}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Text="Action details" FontSize="18" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Button Style="{StaticResource ResetButton}" Margin="8,0,0,0"
                                                    Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Restore this action" Click="RevertAction_Click" />
                                        </StackPanel>
                                        <TextBlock Text="Name" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,14"
                                                 VerticalContentAlignment="Center" />

                                        <TextBlock Text="Icon source" FontWeight="SemiBold" />
                                        <WrapPanel Margin="0,7,0,12">
                                            <RadioButton Content="Glyph" GroupName="IconSource"
                                                         IsChecked="{Binding UseGlyph, Mode=TwoWay}" Margin="0,0,20,6" />
                                            <RadioButton Content="Simple Icons" GroupName="IconSource"
                                                         IsChecked="{Binding UseSimpleIcon, Mode=TwoWay}" Margin="0,0,20,6" />
                                            <RadioButton Content="Custom Icon" GroupName="IconSource"
                                                         IsChecked="{Binding UseAppIcon, Mode=TwoWay}" Margin="0,0,0,6" />
                                        </WrapPanel>

                                        <StackPanel Visibility="{Binding UsesGlyphFont, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14">
                                            <TextBlock Text="Icon" FontWeight="SemiBold" />
                                            <Border Margin="0,7,0,0" Padding="7" CornerRadius="7"
                                                    Background="#08000000" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="2,0,2,7">
                                                        <TextBox x:Name="GlyphSearchBox" Height="34" Padding="34,5,10,5"
                                                                 VerticalContentAlignment="Center"
                                                                 TextChanged="GlyphSearch_TextChanged"
                                                                 ToolTip="Search icons by name, keyword, or Unicode codepoint" />
                                                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   Foreground="{StaticResource MutedBrush}" Margin="11,0,0,0"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                   IsHitTestVisible="False" />
                                                        <TextBlock x:Name="GlyphSearchPlaceholder" Text="Search icons"
                                                                   Foreground="{StaticResource MutedBrush}" Margin="34,0,10,0"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                   IsHitTestVisible="False" />
                                                    </Grid>
                                                    <ListBox x:Name="GlyphList" Height="168" Background="Transparent" BorderThickness="0"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             VirtualizingPanel.IsVirtualizing="True"
                                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Padding" Value="0" />
                                                                <Setter Property="Margin" Value="0" />
                                                                <Setter Property="Focusable" Value="False" />
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <ItemsControl ItemsSource="{Binding}" HorizontalAlignment="Stretch">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Height="38" Margin="2" Padding="0" ToolTip="{Binding Name}"
                                                                                    HorizontalAlignment="Stretch" Click="GlyphChoice_Click">
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                                        <Setter Property="Foreground" Value="#F5F5F5" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                                <Grid>
                                                                                    <Image Source="{Binding Image}" Width="22" Height="22" Stretch="Uniform"
                                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                                           Visibility="{Binding UseImage, Converter={StaticResource BoolToVisibility}}" />
                                                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{Binding Font}" Foreground="{Binding Foreground}" FontSize="18"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                               Visibility="{Binding UseText, Converter={StaticResource BoolToVisibility}}" />
                                                                                </Grid>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Margin="2,7,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                                       Visibility="{Binding UseSimpleIcon, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="Brand icons come from " /><Hyperlink NavigateUri="https://simpleicons.org/"
                                                        RequestNavigate="AuthorLink_RequestNavigate">Simple Icons</Hyperlink><Run Text="." />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding UseAppIcon, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="App icon path" FontWeight="SemiBold" />
                                            <Grid Margin="0,7,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox x:Name="IconPathBox" VerticalAlignment="Stretch"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Column="1" MinWidth="96" Margin="8,0,0,0" Padding="12,0"
                                                        VerticalAlignment="Stretch"
                                                        ToolTip="Choose icon file" Click="BrowseIcon_Click">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Browse…" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="An .ico, .png, image, or executable path." Style="{StaticResource Caption}" Margin="0,0,0,14" />
                                        </StackPanel>
                                        <TextBlock Text="Type" FontWeight="SemiBold" />
                                        <ComboBox x:Name="KindBox" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,14" SelectionChanged="KindBox_SelectionChanged" />
                                        <TextBlock x:Name="TargetLabel" Text="Target" FontWeight="SemiBold" />
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="TargetEditor" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
                                            <Button x:Name="TargetBrowseButton" Grid.Column="1" MinWidth="96" Margin="8,0,0,0" Padding="12,0"
                                                    VerticalAlignment="Stretch" ToolTip="Choose a file or app" Click="BrowseTarget_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Browse…" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <TextBlock x:Name="TargetHint" Style="{StaticResource Caption}" Margin="0,4,0,14" />
                                        <StackPanel x:Name="ArgumentsPanel">
                                            <TextBlock Text="Arguments" FontWeight="SemiBold" />
                                            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,14"
                                                     VerticalContentAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Custom accent" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Accent, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0"
                                                 VerticalContentAlignment="Center" />
                                        <TextBlock Text="Optional hex color. Leave blank to use the global accent." Style="{StaticResource Caption}" />

                                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                                BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,20,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Sub-actions" FontWeight="SemiBold" />
                                                    <TextBlock Text="Add a child to make this action expand on hover." Style="{StaticResource Caption}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Click="AddChild_Click" Margin="12,0,0,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Add child" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ACTIONS RING: an alternate, visual editor over the same Actions collection. -->
                <Grid x:Name="ActionsRingPage" Grid.Column="1" Visibility="Collapsed" Margin="32,26,32,0"
                      AllowDrop="True"
                      PreviewDragOver="ActionsRingPage_PreviewDragOver"
                      PreviewDrop="ActionsRingPage_PreviewDrop">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Actions" Style="{StaticResource PageTitle}" />
                            <Button x:Name="UndoRingChangesButton" Visibility="Collapsed" Margin="10,-3,0,5"
                                    Padding="10,4" VerticalAlignment="Center" ToolTip="Restore all ring actions to the state from when Settings was opened"
                                    Click="UndoRingChanges_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Undo all" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Arrange actions visually. Drag an action onto the ring, or select a ring item to edit it."
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="360" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#09000000" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="10" ClipToBounds="True">
                            <Grid>
                                <Canvas x:Name="RingDesignerCanvas" Width="390" Height="430" AllowDrop="True"
                                        Background="Transparent"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        DragOver="RingTarget_DragOver" />
                                <CheckBox x:Name="PreviewLabelsCheck" IsChecked="False"
                                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-5,0,0"
                                          Height="30" Padding="0" VerticalContentAlignment="Center"
                                          Panel.ZIndex="20" Click="PreviewLabels_Click"
                                          ToolTip="Show or hide labels in this preview only">
                                    <TextBlock Text="Show labels" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </CheckBox>
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16"
                                        Padding="5" CornerRadius="8" Background="#12FFFFFF"
                                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="NewRingActionButton" Click="NewRingAction_Click" Padding="10,6" ToolTip="Create a new action">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="NewRingActionLabel" Text="New action" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel x:Name="SelectedRingCommands" Orientation="Horizontal" Visibility="Collapsed">
                                            <Button x:Name="RingEditCommandButton" Click="RingEditCommand_Click" Padding="10,6" Margin="4,0,4,0" ToolTip="Edit selected action">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Edit" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="RingRemoveCommand_Click" Padding="10,6" Margin="0" ToolTip="Remove selected action">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Remove" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="DeselectRingAction_Click" Content="&#xE711;"
                                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    Padding="10,6" Margin="4,0,0,0" ToolTip="Clear selection" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="RingActionsTab" Click="RingActionsTab_Click" Background="Transparent"
                                            BorderThickness="0" Padding="8,5" FocusVisualStyle="{x:Null}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Actions" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border x:Name="RingActionsTabIndicator" Height="3" CornerRadius="2"
                                                    Background="{StaticResource AccentBrush}" Margin="0,7,0,-5" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RingEditTab" Click="RingEditTab_Click" Background="Transparent"
                                            BorderThickness="0" Padding="8,5" Margin="6,0,0,0" FocusVisualStyle="{x:Null}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Edit" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border x:Name="RingEditTabIndicator" Height="3" CornerRadius="2"
                                                    Background="{StaticResource AccentBrush}" Margin="0,7,0,-5" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RingPresetsTab" Click="RingPresetsTab_Click" Background="Transparent"
                                            BorderThickness="0" Padding="8,5" Margin="6,0,0,0" FocusVisualStyle="{x:Null}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Presets" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border x:Name="RingPresetsTabIndicator" Height="3" CornerRadius="2"
                                                    Background="{StaticResource AccentBrush}" Margin="0,7,0,-5" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <ScrollViewer x:Name="RingActionsTabContent" Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              BorderThickness="0" FocusVisualStyle="{x:Null}"
                                              Margin="0,0,-8,0" Padding="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock Text="Select an item or drag it onto a ring position."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding ActionCategories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander IsExpanded="False" Margin="0,0,0,6">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="14" Width="22" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <StackPanel Margin="0">
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11" Margin="4,0,4,4" TextWrapping="Wrap"
                                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button DataContext="{Binding}"
                                                                        PreviewMouseLeftButtonDown="ActionDragSource_PreviewMouseLeftButtonDown"
                                                                        PreviewMouseMove="ActionDragSource_PreviewMouseMove"
                                                                        Click="PresetAction_Click"
                                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                        Padding="9,7" Margin="0,0,0,4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="&#xE76F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                   FontSize="12" Opacity="0.38"
                                                                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding IconText}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI"
                                                                                   FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="2" Margin="8,0">
                                                                            <TextBlock Text="{Binding Action.Label}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}"
                                                                                       FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="3" Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button DataContext="{Binding DoRingSettingsPreset}"
                                            PreviewMouseLeftButtonDown="ActionDragSource_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="ActionDragSource_PreviewMouseMove"
                                            Click="PresetAction_Click"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="9,7" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE76F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="12" Opacity="0.38"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding IconText}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI"
                                                       FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Margin="8,0">
                                                <TextBlock Text="{Binding Action.Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}"
                                                           FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer x:Name="RingPresetsTabContent" Grid.Row="1" Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              BorderThickness="0" FocusVisualStyle="{x:Null}"
                                              Margin="0,0,-8,0" Padding="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock Text="Switching a preset replaces the actions on the ring."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="4,0,0,12" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="NewPresetNameBox" KeyDown="NewPresetNameBox_KeyDown"
                                                     VerticalContentAlignment="Center" />
                                            <Button Grid.Column="1" Content="&#xE710;" Click="SavePreset_Click"
                                                    Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                                    Height="{Binding ActualHeight, ElementName=NewPresetNameBox}"
                                                    ToolTip="Save the current ring as a preset" />
                                        </Grid>
                                        <Border x:Name="EmptyPresetsMessage" Background="#0AFFFFFF"
                                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                                CornerRadius="7" Padding="14" Margin="0,0,0,8">
                                            <TextBlock Text="No presets saved yet." Foreground="{StaticResource MutedBrush}"
                                                       TextAlignment="Center" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Presets}">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="7" Padding="9" Margin="0,0,0,7">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#0AFFFFFF" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="4,4,0,7" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <Button Click="ApplyPreset_Click" Padding="9,5">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                            <Setter Property="Content" Value="Switch to preset" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                    <Setter Property="Content" Value="Active Preset" />
                                                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                                    <Setter Property="Foreground" Value="#111111" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                    <Setter Property="Cursor" Value="Arrow" />
                                                                                    <Setter Property="Template">
                                                                                        <Setter.Value>
                                                                                            <ControlTemplate TargetType="Button">
                                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                        BorderThickness="1" CornerRadius="5"
                                                                                                        Padding="{TemplateBinding Padding}">
                                                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                                                      VerticalAlignment="Center" />
                                                                                                </Border>
                                                                                            </ControlTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Grid.Column="1" Content="&#xE74D;" Click="DeletePreset_Click"
                                                                        Style="{StaticResource IconButton}" Margin="5,0,0,0"
                                                                        ToolTip="Delete preset" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="PresetStatusText" Foreground="White"
                                                   FontSize="11" TextWrapping="Wrap" Margin="3,3,0,0" />
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid x:Name="RingEditTabContent" Grid.Row="1" Visibility="Collapsed">
                                    <TextBlock x:Name="RingEditEmptyMessage" Text="Select a ring action to edit it."
                                               Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <local:ActionDetailsEditor x:Name="RingDetailsEditor" Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Canvas x:Name="DragPreviewLayer" Grid.RowSpan="2" Panel.ZIndex="1000"
                            IsHitTestVisible="False" ClipToBounds="False" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,0,12" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                        Created with <Run Text="&#x2665;" Foreground="#FF6B81" /> by
                        <Hyperlink NavigateUri="https://dan13.me/?utm_source=DoRing"
                                   RequestNavigate="AuthorLink_RequestNavigate">DanRotaru</Hyperlink>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0"
                                HorizontalAlignment="Center">
                        <Button Style="{StaticResource FooterLinkButton}"
                                ToolTip="GitHub"
                                AutomationProperties.Name="Open Dan Rotaru on GitHub"
                                Tag="https://github.com/danrotaru"
                                Click="ExternalLink_Click">
                            <Viewbox Width="16" Height="16">
                                <Path Fill="{StaticResource MutedBrush}"
                                      Data="M8,0 C3.58,0 0,3.58 0,8 C0,11.54 2.29,14.53 5.47,15.59 C5.87,15.66 6.02,15.42 6.02,15.21 C6.02,15.02 6.01,14.39 6.01,13.72 C4,14.09 3.48,13.23 3.32,12.78 C3.23,12.55 2.84,11.84 2.5,11.65 C2.22,11.5 1.82,11.13 2.49,11.12 C3.12,11.11 3.57,11.7 3.72,11.94 C4.44,13.15 5.59,12.81 6.05,12.6 C6.12,12.08 6.33,11.73 6.56,11.53 C4.78,11.33 2.92,10.64 2.92,7.58 C2.92,6.71 3.23,5.99 3.74,5.43 C3.66,5.23 3.38,4.41 3.82,3.31 C3.82,3.31 4.49,3.1 6.02,4.13 C6.66,3.95 7.34,3.86 8.02,3.86 C8.7,3.86 9.38,3.95 10.02,4.13 C11.55,3.09 12.22,3.31 12.22,3.31 C12.66,4.41 12.38,5.23 12.3,5.43 C12.81,5.99 13.12,6.7 13.12,7.58 C13.12,10.65 11.25,11.33 9.47,11.53 C9.76,11.78 10.01,12.26 10.01,13.01 C10.01,14.08 10,14.94 10,15.21 C10,15.42 10.15,15.67 10.55,15.59 C13.71,14.53 16,11.53 16,8 C16,3.58 12.42,0 8,0 Z" />
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource FooterLinkButton}"
                                ToolTip="Website"
                                AutomationProperties.Name="Open Dan Rotaru's website"
                                Tag="https://dan13.me/?utm_source=DoRing"
                                Click="ExternalLink_Click">
                            <TextBlock Text="&#xE774;" Foreground="{StaticResource MutedBrush}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                        </Button>
                        <TextBlock Text="v0.0.1" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource ContentSurfaceBrush}"
                        BorderThickness="0">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Foreground="#E87A7A" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"
                                MinWidth="86" Height="36" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}"
                                MinWidth="86" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Popup x:Name="FluentColorPopup" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="292" Padding="16" Margin="0,5,0,0" Background="#F52B282D"
                        BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="9">
                    <StackPanel>
                        <TextBlock Text="Choose color" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid x:Name="ColorField" Width="258" Height="150" Cursor="Cross"
                              MouseLeftButtonDown="ColorField_MouseInput" MouseMove="ColorField_MouseInput">
                            <Rectangle x:Name="ColorFieldHue" Fill="#FF0000" />
                            <Rectangle>
                                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                            </Rectangle>
                            <Ellipse x:Name="ColorFieldMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                                     Fill="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                        </Grid>
                        <Border x:Name="HueField" Height="18" Margin="0,12,0,12" CornerRadius="4" Cursor="Hand"
                                MouseLeftButtonDown="HueField_MouseInput" MouseMove="HueField_MouseInput">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FFFF0000" Offset="0"/><GradientStop Color="#FFFFFF00" Offset="0.167"/>
                                    <GradientStop Color="#FF00FF00" Offset="0.333"/><GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#FF0000FF" Offset="0.667"/><GradientStop Color="#FFFF00FF" Offset="0.833"/>
                                    <GradientStop Color="#FFFF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border x:Name="ColorPickerPreview" Width="30" Height="30" CornerRadius="5" BorderBrush="#55FFFFFF" BorderThickness="1" />
                            <TextBox x:Name="ColorPickerHex" Grid.Column="1" Margin="8,0" IsReadOnly="True" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="Done" Click="ColorPickerDone_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
