<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon. WinForms NotifyIcon is the least-friction
         option and saves a NuGet dependency. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\ring.ico</ApplicationIcon>
    <AssemblyName>DoRing</AssemblyName>
    <RootNamespace>DoRing</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <!-- WFO0003 tells WinForms apps to set DPI mode in code instead of the
         manifest. WPF needs it in the manifest, and WinForms is only here for
         the tray icon, so the manifest wins. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>


  <!-- Portable single-file publish: dotnet publish -c Release -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Do NOT enable PublishTrimmed: WPF is not trim-safe. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ring.ico" />
    <Resource Include="Assets\SimpleIcons.ttf" />
    <EmbeddedResource Include="Resources\segoe-fluent-icons-font.md" />
    <EmbeddedResource Include="Resources\simple-icons.txt" />
    <EmbeddedResource Include="Resources\emoji.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds these to the implicit usings, which makes Point,
         Color, Brush and the input event args ambiguous with their WPF
         namesakes in every file. Only App.xaml.cs needs WinForms, and it
         imports it explicitly. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
